#!/usr/bin/env python3
"""jack: the verbs of RUNBOOK.md. The kernel decides; this CLI prepares, signs, appends only what kernel.check admits, then performs
the effects the entry authorises. Untrusted; not kernel. --dry-run, gh run watch and --remove are cut (RUNBOOK.md's last section)."""
import argparse, contextlib, functools, hashlib, io, itertools, json, os, re, shutil, subprocess, sys, tempfile, time  # noqa: E401
sys.path.insert(0, ROOT := os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from judge.judge import changed_by, commits_of, digest as commit_digest  # noqa: E402  SPEC §10.7's own functions
from kernel import check, log  # noqa: E402
from tools import entry  # noqa: E402
from tools.digest import digest  # noqa: E402  the same digest, of the working tree
LOG, ZERO, SEEDS = os.path.join(ROOT, "log.jsonl"), "0" * 64, 100000  # no environment variable changes it
SOURCES = ["kernel/"] + [f"kernel2/{f}.go" for f in "checker canonical ed25519 signature main".split()]
CHECK = [["-m", "unittest", "discover", "-s", "tests", "-t", "."], ["pins/run.py"], ["tools/count_kernel.py"]]
KINDS, CHECKS, CHECKS_POLL = "veto promote budget grant transmute fix".split(), ("judge", "tests"), 10  # the workflows' checks; seconds

class Refused(Exception): """Exit 1: the verb refuses, with its reason."""  # noqa: E701
def refuse(reason): raise Refused(reason)  # noqa: E704
def run(*cmd, cwd=ROOT, ok=True):
    r = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)
    return refuse(f"{' '.join(cmd)} failed (exit {r.returncode}): {r.stderr.strip()[-400:]}") if ok and r.returncode else r
def git(*args, cwd=ROOT, ok=True): return run("git", *args, cwd=cwd, ok=ok).stdout.strip()  # noqa: E704
def fails(*cmd, cwd=ROOT): return run(*cmd, cwd=cwd, ok=False).returncode != 0  # noqa: E704
def show(rev, path): return subprocess.run(["git", "-C", ROOT, "show", f"{rev}:{path}"], capture_output=True).stdout  # noqa: E704
def filled(t): return "\n" not in t and len(f := t.split()) >= 2 and bool(re.fullmatch("[a-z0-9_-]+", f[0])) and "<" not in t  # noqa: E704  one line, a principal token first, then 1+ fields
def trailer(rev): return filled(git("log", "-1", "--format=%(trailers:key=Proposer,valueonly)", rev))  # noqa: E704

def push(*args, cwd=ROOT):  # never forced, never deleting: a rejected push (not a fast-forward) is a refusal, never a retry
    if any(x.startswith(("+", ":")) for x in args) or fails("git", "push", "-q", *args, cwd=cwd):
        refuse(f"git push {' '.join(args)}: a + or deleting refspec, or rejected (not a fast-forward: the branch moved, run again); never forced")

def begin(a, on_main):  # the common preconditions; the party and key_id come from the keys the log declares; None: main for guy only
    git("fetch", "-q", "origin")
    git("status", "--porcelain") and refuse("the tree is not clean: git status --porcelain lists files")
    (branch := git("symbolic-ref", "-q", "--short", "HEAD", ok=False)) or refuse("detached HEAD")
    lines = check.read_lines(open(LOG, "rb").read())  # an invalid log raises the kernel's refusal here
    state = functools.reduce(lambda s, il: check.check_entry(s, *il), enumerate(lines), check.EMPTY)
    blob = log.pubkey_blob(" ".join(open(a.key + ".pub").read().split()[:2]))
    if (key_id := next((k for k, d in state.keys.items() if blob and d.blob == blob), None)) is None:
        refuse(f"{a.key} is not a key the log declares: refused before signing")
    a.branch, a.state, a.lines, a.party, a.key_id, a.trailer = branch, state, lines, state.keys[key_id].principal, key_id, \
        f"Proposer: {state.keys[key_id].principal} {key_id}"
    if not filled((t := a.trailer).removeprefix("Proposer: ")):
        refuse(f"{t!r} is not a filled trailer: one line, a principal matching [a-z0-9_-]+ first, at least one more field, no <")
    re.fullmatch("[a-z0-9_-]+", a.party) or refuse(f"{a.key}'s principal {a.party!r} is not a party: must match [a-z0-9_-]+; refused before signing")
    if (branch == "main") != (on_main := a.party == "guy" if on_main is None else on_main):  # forecast, resolve: the master key's on main
        refuse(f"wrong branch {branch}: this verb runs {'on' if on_main else 'on a branch other than'} main")
    on_main and git("rev-parse", "HEAD") != git("rev-parse", "origin/main") and refuse("main is not up to date: HEAD must equal origin/main")
    if not on_main and fails("git", "merge-base", "--is-ancestor", "origin/main", "HEAD"):
        refuse(f"{branch} does not contain origin/main; run:\n  git merge origin/main -m \"Merge main into {branch}\" -m \"{t}\"")

def append(a, type_, body, log_path=LOG):  # sign on the log's head; append only if kernel.check admits the log with it
    with tempfile.TemporaryDirectory() as d, contextlib.redirect_stdout(out := io.StringIO()):
        with open(path := os.path.join(d, "entry"), "w", encoding="utf-8") as f:
            f.write(entry.unsigned(argparse.Namespace(log=log_path, ts=getattr(a, "decision_ts", None) or entry.now(),
                                                    type=type_, proposer=a.party, body_json=json.dumps(body))))
        subprocess.run(["ssh-keygen", "-Y", "sign", "-f", a.key, "-n", "core-entry", path], check=True, stdout=subprocess.DEVNULL)
        if entry.assemble(argparse.Namespace(unsigned=path, sig=path + ".sig", log=log_path)):
            refuse(f"the kernel refuses the {type_} entry (verdict above); nothing appended")
    data = open(log_path, "rb").read()
    open(log_path, "ab").write((b"\n" if data and not data.endswith(b"\n") else b"") + out.getvalue().encode())

def commit(a, subject, paths, cwd=ROOT):
    git("add", "--", *paths, cwd=cwd)
    git("commit", "-q", "-m", subject, "-m", a.trailer, cwd=cwd)

def watch():  # gh run watch is cut (RUNBOOK.md, bound and custody): printed as the command to run
    print(f"watch main's run:\n  gh run watch --exit-status $(gh run list --branch main --commit {git('rev-parse', 'HEAD')} "
          "--json databaseId --jq '.[0].databaseId')")

def main_ending(a, type_, effect, subject, paths=("log.jsonl",)):  # effect() acts, returns the body; any failure to the push undoes all
    try:
        body = effect()
        git("add", "--", *paths)
        append(a, type_, body)
        commit(a, subject, paths)
        if (r := run(sys.executable, "judge/selfcheck.py", "--repo", ROOT, ok=False)).returncode:
            refuse(f"judge/selfcheck.py fails after the commit: {r.stdout.strip()}")
        push("origin", "main")
    except BaseException as x:  # the tree was clean at the start: what is untracked under transcripts/ the verb placed
        git("reset", "-q", "--hard", "origin/main"), git("clean", "-fdq", "--", "transcripts/")
        refuse(f"{x}\nthe verb's effects are undone (git reset --hard origin/main, its files removed); nothing was pushed")
    watch()

def branch_ending(a, type_, body, subject, title, retitle=False):  # on failure after the commit: the two commands that finish the act
    append(a, type_, body)
    commit(a, subject, ["log.jsonl"])
    try:
        push("-u", "origin", a.branch)
        n = run("gh", "pr", "list", "--head", a.branch, "--state", "open", "--json", "number", "--jq", ".[0].number").stdout.strip()
        retitle and n and run("gh", "pr", "edit", n, "--title", title)  # spec_conflict: an existing PR is retitled so
        return n or run("gh", "pr", "create", "--base", "main", "--head", a.branch, "--title", title, "--body", a.trailer
                        ).stdout.strip().rsplit("/", 1)[-1]
    except Refused as x:
        refuse(f"{x}\nthe commit stands; finish the act with:\n  git push -u origin {a.branch}\n  "
               f"gh pr create --base main --head {a.branch} --title '{title}' --body '{a.trailer}'")

def the_check(cwd):  # the tests, the pins and the kernel line count; any failure refuses
    for r in (run(sys.executable, *cmd, cwd=cwd, ok=False) for cmd in CHECK):
        r.returncode and refuse(f"the check fails: {' '.join(r.args[1:])}\n{(r.stdout + r.stderr)[-1500:]}")

def worktree(rev, fn):  # fn(path) in a temporary detached worktree of rev, removed after
    try:
        git("worktree", "add", "-q", "--detach", tmp := tempfile.mkdtemp(prefix="jack-"), rev)
        return fn(tmp)
    finally:
        shutil.rmtree(tmp, ignore_errors=True), git("worktree", "prune")

def v_key(a):
    begin(a, True)
    if len(fields := open(a.pubkey).read().split()) != 2 or fields[0] != "ssh-ed25519":
        refuse(f"{a.pubkey} is not a two-field ssh-ed25519 line")
    re.fullmatch("[a-z0-9_-]+", a.principal) or refuse(f"principal {a.principal!r} is not [a-z0-9_-]+")
    powers = a.powers.split(",") if a.powers else []
    if bad := [p for p in powers if p not in log.TYPES]:
        refuse(f"powers outside the ten: {', '.join(bad)}")
    if a.declared == a.key_id and "key" not in powers:
        refuse(f"{a.declared} is the signer's own key: re-declaring it without `key` is refused")
    main_ending(a, "key", lambda: {"key_id": a.declared, "principal": a.principal, "pubkey": " ".join(fields), "powers": powers},
                f"key: {a.declared}")

def v_proposal(a):  # commit: the branch's last commit changing a path other than log.jsonl (SPEC §10.7's functions), else HEAD
    begin(a, False)
    the_check(ROOT)
    commit = next((c for c in commits_of(ROOT, "origin/main", "HEAD") if changed_by(ROOT, c) - {"log.jsonl"}), git("rev-parse", "HEAD"))
    title = a.title or git("log", "-1", "--format=%s", commit)
    n = branch_ending(a, "proposal", {"title": title, "commit": commit}, f"proposal: {title}", title)
    print(f"proposal recorded; PR #{n}")

def v_spec_conflict(a):
    begin(a, False)
    n = branch_ending(a, "spec_conflict", {"section": a.section, "text": a.text}, *[f"spec_conflict: {a.section}"] * 2, True)
    print(f"stopped: the specification cannot be implemented as written; see PR #{n}")

def passed(n, sha):  # True once CHECKS succeed on sha; False while one is unreported or running; a failure or a moved head is refused
    r = subprocess.run(["gh", "pr", "checks", n, "--watch"], stderr=subprocess.PIPE, text=True)  # ends when the reported checks end
    if "no checks reported" in r.stderr: return False  # noqa: E701
    r.returncode and refuse(f"PR #{n}'s head {sha[:12]} was not admitted by the judge and the tests; not merged\n{r.stderr.strip()}")
    pr = json.loads(run("gh", "pr", "view", n, "--json", "headRefOid,statusCheckRollup").stdout)
    pr["headRefOid"] == sha or refuse(f"PR #{n}'s head {pr['headRefOid'][:12]} moved off {sha[:12]} during the wait; not merged")
    done = {c.get("name"): c.get("conclusion") for c in pr["statusCheckRollup"]}  # every one of CHECKS: a pending one waits
    return all([done.get(k) == "SUCCESS" or done.get(k) not in (None, "") and refuse(f"PR #{n}'s {k} is {done[k]}; not merged") for k in CHECKS])

def admitted(n, sha):  # the precondition's wait on the proposal's head and the effect's on the entry's: no deadline, saying for what
    print(f"waiting for {' and '.join(CHECKS)} to pass on PR #{n}'s head {sha[:12]}", flush=True)
    while not passed(n, sha): time.sleep(CHECKS_POLL)  # noqa: E701

def v_merge(a):
    begin(a, True)
    pr = json.loads(run("gh", "pr", "view", str(a.n), "--json", "state,baseRefName,mergeable,headRefOid,headRefName").stdout)
    bad = [f"{k} is {pr[k]}, not {w}" for k, w in (("state", "OPEN"), ("baseRefName", "main"), ("mergeable", "MERGEABLE")) if pr[k] != w]
    bad and refuse(f"PR #{a.n}: {'; '.join(bad)}")
    lines, commits = check.read_lines(show(head := pr["headRefOid"], "log.jsonl")), commits_of(ROOT, "origin/main", head)
    named = [e["body"]["commit"] for e in map(json.loads, lines) if e["type"] == "proposal" and e["body"]["commit"] in commits][-1:] \
        if check.check(lines)["ok"] else []  # SPEC §10.7: the last proposal naming a commit of the PR, then only log.jsonl commits
    if not (named and all(changed_by(ROOT, c) <= {"log.jsonl"} for c in itertools.takewhile(lambda c: c != named[0], commits)) or trailer(head)):
        refuse(f"PR #{a.n}'s head is not a valid proposal's commit followed only by log.jsonl commits, and carries no filled Proposer: trailer")
    admitted(str(a.n), head)  # GitHub has admitted the proposal's head before anything is signed
    body = {"proposal": a.n, "commit": head, "checker": digest()}
    sha = worktree(head, lambda tmp: (append(a, "merge", body, os.path.join(tmp, "log.jsonl")),  # a rejected push: the
                                      commit(a, f"merge: #{a.n}", ["log.jsonl"], cwd=tmp),       # proposal moved; refused,
                                      push("origin", f"HEAD:refs/heads/{pr['headRefName']}", cwd=tmp), git("rev-parse", "HEAD", cwd=tmp))[3])
    admitted(str(a.n), sha)  # the effect waits for CHECKS on sha, the head that carries the entry; GitHub then merges only sha
    run("gh", "pr", "merge", str(a.n), "--merge", "--match-head-commit", sha), git("pull", "-q", "--ff-only"), watch()

def make_run(tmp, head):  # never accepted from BRANCH: kernel2/check built once, then harness/diff.py twelve ways into transcripts/
    run("kernel2/build.sh", cwd=tmp)
    os.makedirs(os.path.join(tmp, "transcripts"), exist_ok=True)
    names = [f"transcripts/diff-{SEEDS}-{time.strftime('%Y%m%dT%H%MZ', time.gmtime())}-part{k:02}.json" for k in range(12)]
    procs = [subprocess.Popen([sys.executable, "harness/diff.py", "--seeds", f"{k * SEEDS // 12}:{(k + 1) * SEEDS // 12}",
                               "--b", "kernel2/check"], cwd=tmp, stdout=open(os.path.join(tmp, n), "wb")) for k, n in enumerate(names)]
    [(p.wait(), p.stdout and p.stdout.close()) for p in procs]
    if not entry.valid_run(made := {n: open(os.path.join(tmp, n), "rb").read() for n in names}, head, SEEDS):
        refuse(f"the run of record is not twelve parts of {head[:12]}, each its range's logs, contiguous from 0 to {SEEDS}, "
               "0 disagreements, 0 uncompared")
    return made

def v_push(a):
    begin(a, True)
    if (b := a.target).startswith("+") or fails("git", "rev-parse", "-q", "--verify", f"refs/heads/{b}"):
        refuse(f"{b} is not a local branch")
    if fails("git", "merge-base", "--is-ancestor", "origin/main", b):
        refuse(f"{b} does not contain origin/main")
    if commit_digest(ROOT, b) == commit_digest(ROOT, "HEAD"):
        refuse("nothing to push: propose and merge")
    if bare := [s[:12] for s in git("rev-list", f"origin/main..{b}").split() if not trailer(s)]:
        refuse(f"commits on {b} without a filled Proposer: trailer: {', '.join(bare)}")
    review = None if a.review == "none" else open(a.review, "rb").read()  # an empty file is a review: its hash, not zeros
    needs_run, head = fails("git", "diff", "--quiet", "origin/main", b, "--", *SOURCES), git("rev-parse", b)
    place = worktree(b, lambda tmp: (the_check(tmp), make_run(tmp, head) if needs_run else {})[1])
    review is None and print("WARNING: --review none: this push was not read", file=sys.stderr)
    placed = {**place, **({} if review is None else {f"transcripts/{os.path.basename(a.review)}": review})}
    def effect():  # the fast-forward, the evidence placed, then the body on the tree now on main
        git("merge", "-q", "--ff-only", b)
        for n, data in placed.items():
            os.makedirs(os.path.join(ROOT, "transcripts"), exist_ok=True) or open(os.path.join(ROOT, n), "wb").write(data)
        return {"digest": digest(), "review": ZERO if review is None else hashlib.sha256(review).hexdigest(),
                "record": entry.valid_run(place, head, SEEDS) if needs_run else ZERO}
    main_ending(a, "push", effect, f"push: {b}", ["log.jsonl"] + ["transcripts/"] * bool(placed))
    print(f"--remove is cut (RUNBOOK.md): remove {b}'s worktree, if it has one, with:\n  git worktree remove ~/git/worktrees/jack/{b}")

def v_decision(a):
    begin(a, True)
    a.subject or refuse("SUBJECT must be a non-empty string")
    if a.kind == "promote":
        a.subject in ("C1a", "C1b", "C2a") or refuse("promotion criteria unknown for " + a.subject)
        head = git("rev-parse", "HEAD")
        endpoint = "repos/{owner}/{repo}/actions/workflows/tests.yml/runs"
        def fetch(query):
            pages = json.loads(run("gh", "api", endpoint + query, "--paginate", "--slurp").stdout)
            return [r for page in pages for r in page["workflow_runs"]]
        current = fetch(f"?head_sha={head}&event=push&branch=main")
        history = fetch("?event=push&branch=main")
        a.decision_ts = entry.now()  # the assessed instant is the instant signed, including expiry boundaries
        from tools.status import run_verified
        with tempfile.TemporaryDirectory() as tmp:
            for name, value in (("run", next((r for r in current if run_verified(r, head)), None)), ("runs", history)):
                with open(os.path.join(tmp, name), "w") as f:
                    json.dump(value, f)
            command = [sys.executable, "tools/status.py", "--subject", a.subject, "--run", os.path.join(tmp, "run"),
                       "--runs", os.path.join(tmp, "runs"), "--as-of", a.decision_ts]
            if a.acts:
                command += ["--acts", a.acts]
            result = run(*command).stdout
        lines = [line for line in result.splitlines() if line.startswith(f"promote {a.subject}:")]
        lines == [f"promote {a.subject}: lawful"] or refuse("\n".join(lines) or "status returned no promotion verdict")
    main_ending(a, "decision", lambda: {"kind": a.kind, "subject": a.subject}, f"decision: {a.kind} {a.subject}")

def v_amend(a):
    begin(a, True)
    if a.id not in a.state.transmuted:  # the kernel's state: a valid transmute decision, extra members or not
        refuse("transmute first")
    if any(i == a.id for i, _, _ in a.state.amendments):
        refuse(f"{a.id} is already an amendment")
    if not (text := open(a.file, encoding="utf-8").read()).startswith(f"## Amendment {a.id}:"):
        refuse(f"{a.file}'s first line is not '## Amendment {a.id}:'")
    def effect():  # the charter appended before the entry
        open(path := os.path.join(ROOT, "CHARTER.md"), "ab").write(b"\n" + text.encode())
        return {"id": a.id, "charter": hashlib.sha256(open(path, "rb").read()).hexdigest(),
                "activate_at": len(a.lines) + 1 if a.activate_at is None else a.activate_at}
    main_ending(a, "amend", effect, f"amend: {a.id}", ["CHARTER.md", "log.jsonl"])

def ledger_ending(a, type_, body, subject):  # the master key's is a main verb; any other party's commits log.jsonl on its branch
    if a.party == "guy": return main_ending(a, type_, lambda: body, subject)  # noqa: E701
    append(a, type_, body), commit(a, subject, ["log.jsonl"]), print(f"{type_} committed on {a.branch}; jack proposal pushes it")
def v_forecast(a): begin(a, None), ledger_ending(a, "forecast", entry.forecast_body(a, entry.now()), f"forecast: {' '.join(a.claim.split())[:60]}")  # noqa: E704
def v_resolve(a): begin(a, None), ledger_ending(a, "resolution", entry.resolution_body(a, a.state, a.party), f"resolution: {a.seq} {a.outcome}")  # noqa: E704
def v_score(a): print(entry.score(check.read_lines(open(LOG, "rb").read()), a.as_of))  # noqa: E704  no entry, signing, fetch or clean tree

def main(argv):
    read = argparse.ArgumentParser(add_help=False)
    read.add_argument("--key")
    read.add_argument("verb", nargs="?")
    readonly, rest = read.parse_known_args(argv)
    if readonly.verb in ("status", "clerk"):
        from tools import status, clerk
        return {"status": status.main, "clerk": clerk.main}[readonly.verb](rest)
    ap = argparse.ArgumentParser(prog="jack", description=__doc__)
    ap.add_argument("--key", default=os.environ.get("JACK_KEY", os.path.expanduser("~/.ssh/id_ed25519")))
    sub = ap.add_subparsers(dest="verb", required=True)
    for verb in ("status", "clerk"):
        sub.add_parser(verb, help=f"read-only {verb}; jack {verb} --help lists evidence inputs")
    for verb, specs in (("key", "declared --principal= --powers= --pubkey="), ("proposal", "--title"), ("merge", "n:int"),
                        ("spec_conflict", "--section= --text="), ("push", "target --review="), ("decision", "kind subject --acts"),
                        ("amend", "id file --activate-at:int"), ("forecast", "claim --p:int= --by= --type --args"),
                        ("resolve", "seq:int --outcome:int= --evidence="), ("score", "--as-of")):
        p = sub.add_parser(verb)
        for spec in specs.split():
            name, kind = (spec.rstrip("=").split(":") + ["str"])[:2]
            p.add_argument(name, **{"action": "store_true"} if kind == "bool" else
                           {"type": int if kind == "int" else str, **({"required": True} if spec.endswith("=") else {})})
    try:
        if any("--admin" in x or "--force" in x for x in argv):
            refuse("--admin and --force are refused, always")
        if (a := ap.parse_args(argv)).verb == "decision" and a.kind not in KINDS:
            refuse(f"KIND must be one of {' '.join(KINDS)}, not {a.kind!r}")
        globals()["v_" + a.verb](a)
    except (Refused, entry.Usage, OSError, ValueError, KeyError, log.Refuse, subprocess.CalledProcessError) as x:
        print(f"refused: {x}", file=sys.stderr)
        return 1
    return 0

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
