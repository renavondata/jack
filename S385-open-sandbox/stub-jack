#!/usr/bin/env python3
# SANDBOX STUB of tools/jack: decision fix and push only. Behaviour from $SB_CTL/{fix,push} (one word per line, popped).
import json, os, subprocess, sys
ctl = os.environ['SB_CTL']
def g(*a): return subprocess.run(['git', *a], check=True, capture_output=True, text=True).stdout.strip()
def pop(name, default):
    p = os.path.join(ctl, name)
    try: ls = open(p).read().split()
    except FileNotFoundError: ls = []
    if not ls: return default
    open(p, 'w').write('\n'.join(ls[1:]) + '\n'); return ls[0]
def add(entry_type, body, ts):
    L = [json.loads(l) for l in open('log.jsonl')]
    gsig = next(e['sig'] for e in L if e['seq'] == 5563)
    e = {"body": body, "parent": "0"*64, "proposer": "guy", "seq": L[-1]['seq'] + 1, "sig": gsig, "ts": ts, "type": entry_type}
    open('log.jsonl', 'a').write(json.dumps(e, sort_keys=True, separators=(',', ':')) + '\n')
    g('-c','user.name=sb','-c','user.email=sb@invalid','commit','-q','-am', f'{entry_type}: sandbox')
    g('push','-q','origin','HEAD:main')
    return e['seq']
a = sys.argv[1:]
open(os.path.join(ctl, 'calls'), 'a').write(' '.join(a[:3])[:60] + '\n')
if a[:2] == ['decision', 'fix']:
    if pop('fix', 'ok') == 'refuse': print('refused: sandbox fix refusal'); sys.exit(1)
    print('fix entered at seq', add('decision', {"kind": "fix", "subject": a[2]}, "2026-11-30T01:00:00Z")); sys.exit(0)
if a[:1] == ['push']:
    mode = pop('push', 'ok')
    g('fetch','-q','origin')
    if g('rev-parse','HEAD') != g('rev-parse','origin/main'): print('refused: main is not up to date: HEAD must equal origin/main'); sys.exit(1)
    if mode == 'ok':
        print('push entered at seq', add('push', {"digest": "0"*64, "review": "0"*64, "record": "0"*64}, "2026-11-30T02:00:00Z")); sys.exit(0)
    if mode == 'moved':
        d = os.path.join(ctl, 'mover'); subprocess.run(['git','clone','-q', g('remote','get-url','origin'), d], check=True)
        open(os.path.join(d,'MOVED'),'a').write('x\n'); subprocess.run(['git','-C',d,'add','MOVED'],check=True)
        subprocess.run(['git','-C',d,'-c','user.name=sb','-c','user.email=sb@invalid','commit','-q','-m','other merge'],check=True)
        subprocess.run(['git','-C',d,'push','-q','origin','HEAD:main'],check=True); subprocess.run(['rm','-rf',d])
        print('refused: git push origin HEAD:refs/heads/main: rejected (not a fast-forward: the branch moved, run again); never forced'); sys.exit(1)
    print('refused: sandbox refusal for another reason'); sys.exit(1)
print('stub: unknown', a); sys.exit(2)
