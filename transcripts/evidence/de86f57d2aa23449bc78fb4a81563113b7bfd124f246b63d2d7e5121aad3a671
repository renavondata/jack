                // third-party cookies blocked, JS storage denied -- would otherwise reload
                // forever, which is worse than the stale panel this is fixing.
                var now = Date.now(), last = 0;
                try { last = parseInt(sessionStorage.getItem('cf-challenge-reload') || '0', 10) || 0; } catch (e) {}
                if (now - last < 20000) return;
                try { sessionStorage.setItem('cf-challenge-reload', String(now)); } catch (e) {}
                window.location.reload();
            }
