<script>
    $(function () {
        $(".js_racecard img").mouseover(function () {
            var imgurl = $(this).attr("src");
            var suffix = imgurl.substring(imgurl.lastIndexOf("."), imgurl.length);
            var newimgurl = "";
            if (imgurl.indexOf("_o") < 0) {
                newimgurl = imgurl.substring(0, imgurl.lastIndexOf(".")) + "_r" + suffix;
                $(this).addClass("active");
                $(this).attr("src", newimgurl);
                $(this).attr("delSrc", imgurl);
            }
        })
        $(".js_racecard img").mouseout(function () {
            if ($(this).hasClass("active")) {
                var imgurl = $(this).attr("delSrc");
                $(this).attr("src", imgurl);
            }
        })

        $("#submitBtn").click(function () {
            var selectedMeeting = JSON.parse($("#selectId").val());
            var raceDate = selectedMeeting.date.toString().split('/').reverse().join('/');
            raceDate += selectedMeeting.venue?.toString() === "" ? "" : "&Racecourse=" + selectedMeeting.venue?.toString();
            window.location.href = "/en-us/local/information/localresults?racedate=" + raceDate;
        })
    })
    function pop_window(url_location, popupWidth) {
        var width = popupWidth || 790;
        Welcome = window.top.open(url_location, 'Welcome', 'width=' + width + ',height=710,status=0,location=0,titlebar=0,directories=0,menubar=0,resizable=1,scrollbars=yes,screenX=150,screenY=100');
    }

    $(document).ready(function () {
        if (window.location.href.includes('/archive/')) {
            populateDropdown();
        }

        function populateDropdown() {
            const $select = $('#selectId');
            const apiUrl = '/racing/information/json/DateList/LocalResults.aspx?lang=en-us';

            $.ajax({
                url: apiUrl,
                type: 'GET',
                dataType: 'json',
                success: function (data) {
                    const urlParams = new URLSearchParams(window.location.search.toLowerCase());
                    const urlDate = urlParams.get('racedate');
                    const urlRacecourse = urlParams.get('racecourse');
                    const [urlyear, urlmonth, urlday] = urlDate.split('/');

                    $select.empty();

                    $.each(data.MeetingDateList, function (index, item) {
                        const rawDateStr = item.Key.split('T')[0];
                        const [year, month, day] = rawDateStr.split('-');
                        const displayDate = `${day}/${month}/${year}`;

                        let venueKey = "";
                        let venueName = "";

                        if (item.Value && Object.keys(item.Value).length > 0) {
                            venueKey = Object.keys(item.Value)[0];
                            venueName = item.Value[venueKey];
                        }

                        const valueObj = {
                            date: displayDate,
                            venue: venueKey
                        };

                        const optionValueStr = JSON.stringify(valueObj);
                        const optionTextStr = venueName ? `${displayDate} ${venueName}` : `${displayDate} `;

                        const $option = $('<option>', {
                            value: optionValueStr,
                            text: optionTextStr
                        });

                        if (year === urlyear && month === urlmonth && day === urlday && (!venueKey || urlRacecourse.toUpperCase() === venueKey)) {
                            $option.prop('selected', true);
                        }

                        $select.append($option);
                    });
                },
                error: function (xhr, status, error) { }
            });
        }
    });
</script>

