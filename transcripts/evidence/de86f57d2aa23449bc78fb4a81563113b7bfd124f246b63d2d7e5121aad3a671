    function ReplaceLanguage(urlhref) {
        if ("en-us" == "en-us")
        {
            return urlhref.replace(/English/gi, "Chinese").replace(/en-us/gi, "zh-hk");
        }
        else
        {
            return urlhref.replace(/English/gi, "English").replace(/en-us/gi, "en-us");
        }
    }

