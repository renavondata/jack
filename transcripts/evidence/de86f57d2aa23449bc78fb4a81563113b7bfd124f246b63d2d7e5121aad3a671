    <script>
        // Any failed htmx request (network error or non-2xx response) leaves its
        // swap target unchanged by default — silent from the user's perspective.
        // Render a visible, retryable error into the target instead.
        (function () {
            var retryLabel = "Retry";
            var errorLabel = "Something went wrong loading results.";
            function handleHtmxError(evt) {
                var target = evt.detail.target;
                if (!target || !target.id) return;
                // A sustained outage re-fires this on every keystroke of a live-search
                // input — without this guard that would blow away the retry button and
                // re-announce the alert on every request.
                if (target.querySelector('#htmx-error-box')) return;
                // requestConfig.path is the route template *before* query params are
                // interpolated (e.g. "/search", not "/search?q=..&page=.."); the fully
                // resolved URL htmx actually sent is pathInfo.finalRequestPath.
                var info = evt.detail.pathInfo || {};
                var cfg = evt.detail.requestConfig || {};
                var elt = evt.detail.elt;
                var verb = cfg.verb || 'get';
                var path = info.finalRequestPath || cfg.path;
                // Some triggers (search) hx-select a fragment out of a full-page
                // response and hx-swap="outerHTML" it in; others (waitlist) just
                // hx-swap innerHTML with no select. Read the trigger's own attrs
                // at retry time rather than assuming one shape for every target.
                var select = elt && elt.getAttribute('hx-select');
                var swap = (elt && elt.getAttribute('hx-swap')) || 'innerHTML';
                // If focus was inside the content we're about to replace, it would
                // otherwise silently fall back to <body> — move it to the new alert.
                var hadFocusInside = target.contains(document.activeElement) && document.activeElement !== document.body;
                target.innerHTML =
                    '<div class="text-center py-12" role="alert" id="htmx-error-box" tabindex="-1">' +
                    '<p class="text-ink-soft text-lg mb-4">' + errorLabel + '</p>' +
                    (path ? '<button type="button" class="cta-gold" id="htmx-retry-btn">' + retryLabel + '</button>' : '') +
                    '</div>';
                var box = document.getElementById('htmx-error-box');
                var btn = document.getElementById('htmx-retry-btn');
                if (btn && path) {
                    btn.addEventListener('click', function () {
                        box.remove();
                        htmx.ajax(verb, path, {source: elt, target: target, swap: swap, select: select || undefined});
                    });
                }
                if (hadFocusInside && box) {
                    box.focus();
                }
            }
            // A Cloudflare managed challenge (renavondata/renavon-monorepo#1469) answers an hx-get with 403 and
            // `cf-mitigated: challenge`. htmx does not swap a 4xx body, so without this the
            // target silently keeps its stale content and the page just stops updating.
            // That is the tab-left-open case: cf_clearance is honoured on XHRs but expires
            // after 30 minutes, and only a TOP-LEVEL navigation can present the
            // interstitial and mint a new one -- an XHR cannot.
            //
            // So reload rather than render the error box below. Clearing isError is what
            // stops that box from claiming an outage: htmx 2.0.4 gates htmx:responseError
            // on that flag alone, after the swap block (verified in the vendored bundle,
            // not assumed), so it is the only way to say "handled, and not a failure".
            function handleCfChallenge(evt) {
                var xhr = evt.detail && evt.detail.xhr;
                if (!xhr) return;
                var mitigated = xhr.getResponseHeader('cf-mitigated') || '';
                if (mitigated.toLowerCase().indexOf('challenge') === -1) return;
